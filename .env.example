AI_GATEWAY_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
DATABASE_PATH=./data/expenses.db
# Local (npm start): http://127.0.0.1:8080
# Docker Compose overrides this to http://signal-cli-rest-api:8080 for the worker.
SIGNAL_API_URL=http://127.0.0.1:8080
SIGNAL_PHONE_NUMBER=+48123123123
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Rclone Backup Configuration
# Name of the remote configured in rclone.conf (e.g., gdrive, my_dropbox, s3)
BACKUP_REMOTE_NAME=gdrive

# Signal-CLI Image (Architecture fallback)
# By default, the project uses the ultra-fast '-native' image (64-bit only).
# If you are running on a 32-bit OS (like older Raspberry Pi OS), uncomment the line below:
# SIGNAL_CLI_IMAGE=bbernhard/signal-cli-rest-api:latest
