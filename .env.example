AI_GATEWAY_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
DATABASE_PATH=./data/expenses.db
# Raw TCP JSON-RPC endpoint exposed by `signal-cli daemon --tcp`.
# Docker Compose overrides these values to signal-cli:6001 for the worker.
SIGNAL_RPC_HOST=127.0.0.1
SIGNAL_RPC_PORT=6001
SIGNAL_PHONE_NUMBER=+48123123123
# Comma-separated Signal device IDs allowed to send self-chat commands.
SIGNAL_ALLOWED_INPUT_DEVICE_IDS=1
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Rclone Backup Configuration
# Name of the remote configured in rclone.conf (e.g., gdrive, my_dropbox, s3)
BACKUP_REMOTE_NAME=gdrive

# Optional Signal CLI image override.
# The default signal-cli-native image targets 64-bit systems. On older or
# 32-bit Raspberry Pi installations, uncomment the tested compatible fallback:
# SIGNAL_CLI_IMAGE=bbernhard/signal-cli-rest-api:latest
